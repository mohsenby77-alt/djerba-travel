{from:"🇹🇳 تونس",to:"🇦🇪 دبي",time:"5h 30m",price:520}
]}

function renderFlights(){
var flights=getFlights(),html='';
flights.forEach(function(f){
html+='<div class="fl rv"><div class="route"><span class="city">'+f.from+'</span><span class="arrow">✈️ →</span><span class="city">'+f.to+'</span></div><div class="finfo"><div class="time">🕐 '+f.time+' | '+D[lang].direct+'</div><div class="fprice">'+f.price+' DT <small>'+D[lang].oneWay+'</small></div></div><button class="fbtn" onclick="bookItem(\'flight\',\''+f.from+' → '+f.to+'\')">'+(lang==='ar'?'احجز الآن':lang==='fr'?'Réserver':'Book Now')+'</button></div>';
});
document.getElementById('flightsGrid').innerHTML=html;
document.querySelectorAll('#flightsGrid .rv').forEach(function(e){e.classList.add('vis')});
}

function addFlight(){
var f={from:document.getElementById('fFrom').value,to:document.getElementById('fTo').value,time:document.getElementById('fTime').value,price:parseInt(document.getElementById('fPrice').value)};
if(!f.from||!f.to||!f.price){alert('أدخل جميع البيانات!');return}
var flights=getFlights();flights.push(f);localStorage.setItem('tj_flights',JSON.stringify(flights));
document.getElementById('fFrom').value='';document.getElementById('fTo').value='';document.getElementById('fTime').value='';document.getElementById('fPrice').value='';
renderFlights();renderFlightsList();showSucc();
}

function renderFlightsList(){
var flights=getFlights(),html='';
if(!flights.length){html='<div class="no-data">لا توجد رحلات</div>'}
else{flights.forEach(function(f,i){html+='<div class="adm-car-card"><button class="del" onclick="delFlight('+i+')">✕</button><div class="info"><h4>'+f.from+' → '+f.to+'</h4><p>'+f.price+' DT | '+f.time+'</p></div></div>'})}
document.getElementById('flightsList').innerHTML=html;
}

function delFlight(i){var flights=getFlights();flights.splice(i,1);localStorage.setItem('tj_flights',JSON.stringify(flights));renderFlights();renderFlightsList()}

// ============ BOOKING ============
function openBooking(){document.getElementById('mbg').classList.add('open')}
function closeBooking(){document.getElementById('mbg').classList.remove('open')}
function bookItem(type,detail){openBooking();document.getElementById('mfType').value=type;document.getElementById('mfDetail').value=detail}

function submitBooking(e){
e.preventDefault();
var client={name:document.getElementById('mfName').value,email:document.getElementById('mfEmail').value,phone:document.getElementById('mfPhone').value,type:document.getElementById('mfType').value,detail:document.getElementById('mfDetail').value,date:new Date().toLocaleString(),lang:lang};
