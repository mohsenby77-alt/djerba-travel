});
document.getElementById('carsGrid').innerHTML=html;
document.querySelectorAll('#carsGrid .rv').forEach(function(e){e.classList.add('vis')});
}

function addCar(){
var c={name:document.getElementById('cName').value,img:document.getElementById('cImg').value,cat:document.getElementById('cCat').value,fuel:document.getElementById('cFuel').value,gear:document.getElementById('cGear').value,ppl:parseInt(document.getElementById('cPpl').value),price:parseInt(document.getElementById('cPrice').value)};
if(!c.name||!c.price){alert('أدخل الاسم والسعر!');return}
var cars=getCars();cars.push(c);localStorage.setItem('tj_cars',JSON.stringify(cars));
document.getElementById('cName').value='';document.getElementById('cImg').value='';document.getElementById('cPrice').value='';
renderCars();renderCarsList();showSucc();
}

function renderCarsList(){
var cars=getCars(),html='';
if(!cars.length){html='<div class="no-data">لا توجد سيارات</div>'}
else{cars.forEach(function(c,i){html+='<div class="adm-car-card"><button class="del" onclick="delCar('+i+')">✕</button><img src="'+c.img+'" onerror="this.src=\'https://via.placeholder.com/80x60?text=Car\'"><div class="info"><h4>'+c.name+'</h4><p>'+c.price+' DT/'+(lang==='ar'?'يوم':'day')+' | '+c.fuel+' | '+c.gear+'</p></div></div>'})}
document.getElementById('carsList').innerHTML=html;
}

function delCar(i){var cars=getCars();cars.splice(i,1);localStorage.setItem('tj_cars',JSON.stringify(cars));renderCars();renderCarsList()}

