function doLogout(){sessionStorage.removeItem('tj_auth');closeAdmin()}

function showTab(tab){
document.querySelectorAll('.adm-sec').forEach(function(e){e.classList.remove('active')});
document.querySelectorAll('.adm-tab button').forEach(function(e){e.classList.remove('on')});
document.getElementById('tab-'+tab).classList.add('active');
event.target.classList.add('on');
}

function saveSettings(){
var d={name:document.getElementById('aName').value,addr:document.getElementById('aAddr').value,phone:document.getElementById('aPhone').value,email:document.getElementById('aEmail').value,wa:document.getElementById('aWa').value};
localStorage.setItem('tj_adm',JSON.stringify(d));loadAdminData();showSucc();
