function getFlights(){return JSON.parse(localStorage.getItem('tj_flights')||'null')||[
{from:"🇹🇳 تونس",to:"🇫🇷 باريس",time:"2h 30m",price:290},
{from:"🇹🇳 تونس",to:"🇹🇷 اسطنبول",time:"3h 00m",price:350},
