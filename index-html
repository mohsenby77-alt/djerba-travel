<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Tunisia Travel | كراء سيارات وحجز طيران تونس</title>
<meta name="description" content="كراء سيارات وحجز تذاكر طائرة في تونس - أسعار تنافسية">
<link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>✈️</text></svg>">
<link href="https://fonts.googleapis.com/css2?family=Cairo:wght@300;400;600;700;900&display=swap" rel="stylesheet">
<style>
:root{--pri:#0F4C81;--pri2:#1B6CA8;--pri3:#4FC3F7;--acc:#FF6B35;--acc2:#FF8C42;--gold:#FFB347;--sand:#F8F9FA;--w:#fff;--dark:#0A1628;--gray:#64748B;--light:#F1F5F9;--grad1:linear-gradient(135deg,#0F4C81,#1B6CA8,#4FC3F7);--grad2:linear-gradient(135deg,#FF6B35,#FF8C42);--grad3:linear-gradient(135deg,#1B6CA8,#0F4C81);--sh:0 8px 30px rgba(0,0,0,.08);--sh2:0 20px 60px rgba(0,0,0,.12);--r:16px;--r2:10px;--tr:all .35s ease}
*,*::before,*::after{margin:0;padding:0;box-sizing:border-box}html{scroll-behavior:smooth}body{font-family:'Cairo',sans-serif;background:var(--sand);color:var(--dark);overflow-x:hidden;line-height:1.8}img{max-width:100%;display:block}a{text-decoration:none;color:inherit}ul{list-style:none}button{font-family:'Cairo';cursor:pointer;border:none}input,select,textarea{font-family:'Cairo'}

.ld{position:fixed;inset:0;z-index:9999;background:var(--pri);display:flex;align-items:center;justify-content:center;flex-direction:column;transition:opacity .5s,visibility .5s}
.ld.done{opacity:0;visibility:hidden}.ld .icon{font-size:4.5rem;animation:ldAn 1.2s ease-in-out infinite}.ld p{color:#fff;font-size:1.3rem;font-weight:700;margin-top:15px}
@keyframes ldAn{0%,100%{transform:scale(1)}50%{transform:scale(1.15)}}

.nav{position:fixed;top:0;width:100%;z-index:1000;padding:16px 0;transition:var(--tr)}
.nav.sc{background:rgba(255,255,255,.98);backdrop-filter:blur(25px);box-shadow:0 2px 40px rgba(0,0,0,.08);padding:10px 0}
.nw{max-width:1300px;margin:0 auto;padding:0 30px;display:flex;justify-content:space-between;align-items:center}
.lg{display:flex;align-items:center;gap:10px;font-size:1.55rem;font-weight:900;color:var(--w);transition:var(--tr);text-decoration:none}
.nav.sc .lg{color:var(--pri)}.lg .ic{font-size:2rem}.lg span{color:var(--gold)}
.nm{display:flex;align-items:center;gap:25px}
.nm a{color:rgba(255,255,255,.9);font-weight:600;font-size:.92rem;transition:var(--tr);position:relative;padding:5px 0}
.nav.sc .nm a{color:var(--dark)}.nm a:hover{color:var(--gold)}
.nm a::after{content:'';position:absolute;bottom:0;right:0;width:0;height:2.5px;background:var(--grad2);border-radius:2px;transition:var(--tr)}
.nm a:hover::after{width:100%}
.lsw{display:flex;gap:3px;background:rgba(255,255,255,.15);border-radius:50px;padding:3px;border:1px solid rgba(255,255,255,.2)}
.nav.sc .lsw{background:var(--light);border-color:#e2e8f0}
.lb2{padding:6px 13px;border:none;border-radius:50px;font-size:.76rem;font-weight:800;background:transparent;color:rgba(255,255,255,.8);transition:var(--tr)}
.nav.sc .lb2{color:var(--gray)}.lb2.on{background:var(--grad2);color:#fff!important}
.bg2{display:none;flex-direction:column;cursor:pointer;gap:6px;background:none;padding:5px}
.bg2 span{width:26px;height:2.5px;background:var(--w);border-radius:3px;transition:var(--tr)}
.nav.sc .bg2 span{background:var(--dark)}

.hero{min-height:100vh;display:flex;align-items:center;justify-content:center;position:relative;background:linear-gradient(135deg,rgba(15,76,129,.88),rgba(27,108,168,.75),rgba(79,195,247,.6)),url('https://images.unsplash.com/photo-1436491865332-7a61a109db05?w=1920&q=80') center/cover fixed;color:var(--w)}
.hero::after{content:'';position:absolute;bottom:0;left:0;right:0;height:140px;background:linear-gradient(transparent,var(--sand))}
.hi{position:relative;z-index:2;text-align:center;padding:0 20px;max-width:850px;width:100%}
.htag{display:inline-flex;align-items:center;gap:10px;background:rgba(255,255,255,.12);backdrop-filter:blur(15px);padding:10px 30px;border-radius:50px;font-size:.95rem;margin-bottom:25px;border:1px solid rgba(255,255,255,.2);animation:fl 3s ease-in-out infinite}
.hero h1{font-size:clamp(2.8rem,8vw,5.2rem);font-weight:900;line-height:1.15;margin-bottom:18px;text-shadow:0 4px 30px rgba(0,0,0,.2)}
.hero h1 em{font-style:normal;background:linear-gradient(135deg,var(--gold),var(--acc));-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.hero>.hi>p{font-size:clamp(1.05rem,2.5vw,1.35rem);max-width:650px;margin:0 auto 45px;opacity:.92;line-height:2}
.hbs{display:flex;gap:16px;justify-content:center;flex-wrap:wrap}
.btn{padding:16px 38px;border-radius:50px;font-weight:700;font-size:1.05rem;transition:var(--tr);display:inline-flex;align-items:center;gap:10px}
.b1{background:var(--grad2);color:#fff;box-shadow:0 10px 35px rgba(255,107,53,.35)}.b1:hover{transform:translateY(-4px);box-shadow:0 16px 45px rgba(255,107,53,.45)}
.b2{background:rgba(255,255,255,.12);color:#fff;border:2px solid rgba(255,255,255,.5);backdrop-filter:blur(10px)}.b2:hover{background:#fff;color:var(--pri);transform:translateY(-4px)}
@keyframes fl{0%,100%{transform:translateY(0)}50%{transform:translateY(-10px)}}

section{padding:100px 20px}.sh{text-align:center;margin-bottom:60px}
.sh .tag2{display:inline-block;background:var(--light);color:var(--pri);padding:6px 20px;border-radius:50px;font-size:.85rem;font-weight:700;margin-bottom:15px}
.sh h2{font-size:clamp(2rem,4.5vw,2.8rem);color:var(--pri);margin-bottom:12px;font-weight:900}
.sh p{color:var(--gray);font-size:1.1rem;max-width:580px;margin:0 auto}.sh .bar{width:50px;height:4px;background:var(--grad2);margin:18px auto;border-radius:4px}
.wr{max-width:1300px;margin:0 auto}

.stb{display:grid;grid-template-columns:repeat(4,1fr);max-width:1000px;margin:60px auto 0}
.st{text-align:center;padding:25px 15px;position:relative}
.st::after{content:'';position:absolute;left:0;top:20%;height:60%;width:1px;background:#e2e8f0}
.st:last-child::after{display:none}
.st .sn{font-size:2.2rem;font-weight:900;background:var(--grad1);-webkit-background-clip:text;-webkit-text-fill-color:transparent}
.st .sl{color:var(--gray);font-size:.88rem;margin-top:3px}

.srvs{background:var(--w)}.srvg{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:28px}
.srv{background:var(--sand);border-radius:var(--r);padding:45px 30px;text-align:center;transition:var(--tr);border:2px solid transparent;position:relative;overflow:hidden}
.srv::before{content:'';position:absolute;top:0;left:0;width:100%;height:5px;background:var(--grad1);transform:scaleX(0);transition:var(--tr)}
.srv:hover::before{transform:scaleX(1)}.srv:hover{border-color:var(--pri3);transform:translateY(-10px);box-shadow:var(--sh2)}
.srv .sic{font-size:3.5rem;margin-bottom:18px}.srv h3{color:var(--pri);margin-bottom:12px;font-size:1.25rem}.srv p{color:var(--gray);font-size:.95rem}
.srv .feat{display:flex;flex-direction:column;gap:8px;margin-top:18px;text-align:right;list-style:none;padding:0}
[dir="ltr"] .srv .feat{text-align:left}
.srv .feat li{font-size:.88rem;color:var(--dark);display:flex;align-items:center;gap:8px}
.srv .feat li::before{content:'✓';color:#10B981;font-weight:900}

.carg{display:grid;grid-template-columns:repeat(auto-fill,minmax(350px,1fr));gap:28px}
.car{background:var(--w);border-radius:var(--r);overflow:hidden;box-shadow:var(--sh);transition:var(--tr)}
.car:hover{transform:translateY(-10px);box-shadow:var(--sh2)}
.car .cimg{height:220px;overflow:hidden;position:relative;background:var(--light)}
.car .cimg img{width:100%;height:100%;object-fit:cover;transition:transform .5s}.car:hover .cimg img{transform:scale(1.08)}
.car .ctag{position:absolute;top:15px;right:15px;background:var(--grad2);color:#fff;padding:5px 14px;border-radius:50px;font-size:.78rem;font-weight:700}
[dir="ltr"] .car .ctag{right:auto;left:15px}
.car .cinfo{padding:25px}.car .cinfo h3{font-size:1.25rem;color:var(--pri);margin-bottom:8px}
.car .specs{display:flex;gap:20px;flex-wrap:wrap;margin:12px 0}
.car .spec{display:flex;align-items:center;gap:6px;font-size:.85rem;color:var(--gray)}
.car .price{display:flex;justify-content:space-between;align-items:center;margin-top:15px;padding-top:15px;border-top:1px solid var(--light)}
.car .price .pr{font-size:1.5rem;font-weight:900;color:var(--acc);direction:ltr}
.car .price .pr small{font-size:.85rem;color:var(--gray);font-weight:400}
.car .price .btn{padding:10px 24px;font-size:.9rem}

.flg{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:25px}
.fl{background:var(--sand);border-radius:var(--r);padding:28px;transition:var(--tr);border:2px solid transparent}
.fl:hover{border-color:var(--pri3);transform:translateY(-5px);box-shadow:var(--sh)}
.fl .route{display:flex;align-items:center;justify-content:space-between;margin-bottom:18px}
.fl .city{font-size:1.15rem;font-weight:800;color:var(--pri)}.fl .arrow{font-size:1.3rem;color:var(--gold)}
.fl .finfo{display:flex;justify-content:space-between;align-items:center;margin-bottom:15px}
.fl .finfo .time{font-size:.92rem;color:var(--gray)}.fl .finfo .fprice{font-size:1.4rem;font-weight:900;color:var(--acc);direction:ltr}
.fl .fprice small{font-size:.85rem;color:var(--gray);font-weight:400}
.fl .fbtn{width:100%;padding:13px;border-radius:12px;background:var(--grad1);color:#fff;font-weight:700;font-size:1rem;transition:var(--tr)}
.fl .fbtn:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(15,76,129,.3)}

.why{background:var(--grad3);color:#fff;position:relative;overflow:hidden}
.why::before{content:'';position:absolute;top:-50%;left:-50%;width:200%;height:200%;background:radial-gradient(circle,rgba(255,255,255,.05),transparent 60%);animation:spin 30s linear infinite}
@keyframes spin{0%{transform:rotate(0)}100%{transform:rotate(360deg)}}
.whyg{display:grid;grid-template-columns:repeat(auto-fill,minmax(280px,1fr));gap:28px;position:relative;z-index:2}
.why-c{text-align:center;padding:35px 20px}
.why-c .wic{width:80px;height:80px;background:rgba(255,255,255,.12);border-radius:20px;display:flex;align-items:center;justify-content:center;font-size:2.2rem;margin:0 auto 20px;backdrop-filter:blur(10px);border:1px solid rgba(255,255,255,.15)}
.why-c h3{font-size:1.2rem;margin-bottom:10px}.why-c p{opacity:.8;font-size:.95rem}

.test{background:var(--w)}.testg{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:28px}
.tst{background:var(--sand);border-radius:var(--r);padding:35px;transition:var(--tr)}
.tst:hover{transform:translateY(-5px);box-shadow:var(--sh)}
.tst .stars{color:var(--gold);font-size:1.1rem;margin-bottom:15px}
.tst p{color:var(--gray);font-size:.98rem;line-height:2;margin-bottom:20px;font-style:italic}
.tst .user{display:flex;align-items:center;gap:15px}
.tst .user .av{width:50px;height:50px;border-radius:50%;background:var(--grad1);display:flex;align-items:center;justify-content:center;color:#fff;font-weight:800;font-size:1.1rem}
.tst .user h4{color:var(--pri);font-size:.98rem}.tst .user span{color:var(--gray);font-size:.82rem}

.cta{background:var(--grad2);text-align:center;position:relative;overflow:hidden}
.cta::before{content:'';position:absolute;inset:0;background:radial-gradient(circle at 30% 50%,rgba(255,255,255,.1),transparent 50%)}
.cta h2{font-size:clamp(2rem,5vw,3rem);color:#fff;margin-bottom:15px;font-weight:900;position:relative;z-index:2}
.cta p{color:rgba(255,255,255,.85);font-size:1.15rem;max-width:550px;margin:0 auto 35px;position:relative;z-index:2}
.cta .btn{background:#fff;color:var(--acc);position:relative;z-index:2;box-shadow:0 10px 35px rgba(0,0,0,.15)}.cta .btn:hover{transform:translateY(-4px)}

footer{background:var(--dark);color:#fff;padding:70px 20px 30px}
.ftg{max-width:1300px;margin:0 auto;display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:45px;margin-bottom:50px}
.ftc h3{font-size:1.15rem;margin-bottom:18px;color:var(--gold)}
.ftc p{color:rgba(255,255,255,.6);font-size:.93rem;line-height:1.9}
.ftc a{color:rgba(255,255,255,.6);display:block;font-size:.92rem;padding:5px 0;transition:var(--tr)}
.ftc a:hover{color:var(--gold);padding-right:8px}
[dir="ltr"] .ftc a:hover{padding-right:0;padding-left:8px}
.soc{display:flex;gap:10px;margin-top:20px}
.soc a{width:44px;height:44px;background:rgba(255,255,255,.08);border-radius:var(--r2);display:flex;align-items:center;justify-content:center;font-size:1.2rem;transition:var(--tr);padding:0!important}
.soc a:hover{background:var(--grad2);transform:translateY(-4px)}
.ftb{text-align:center;padding-top:35px;border-top:1px solid rgba(255,255,255,.08);color:rgba(255,255,255,.4);font-size:.88rem}

.wa{position:fixed;bottom:30px;right:30px;width:58px;height:58px;background:#25D366;color:#fff;border-radius:50%;display:flex;align-items:center;justify-content:center;font-size:1.7rem;box-shadow:0 8px 30px rgba(37,211,102,.4);z-index:999;transition:var(--tr);text-decoration:none}
[dir="ltr"] .wa{right:auto;left:30px}.wa:hover{transform:scale(1.1)}
.tot2{position:fixed;bottom:100px;right:30px;width:48px;height:48px;background:var(--grad1);color:#fff;border-radius:50%;font-size:1.2rem;display:flex;align-items:center;justify-content:center;opacity:0;visibility:hidden;transition:var(--tr);box-shadow:0 8px 25px rgba(15,76,129,.3);z-index:998;cursor:pointer;border:none}
[dir="ltr"] .tot2{right:auto;left:30px}.tot2.show{opacity:1;visibility:visible}.tot2:hover{transform:translateY(-5px)}

.mbg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:2000;display:none;align-items:center;justify-content:center;backdrop-filter:blur(5px)}
.mbg.open{display:flex}
.mbox{background:#fff;border-radius:var(--r);padding:45px;max-width:520px;width:92%;position:relative;max-height:90vh;overflow-y:auto}
.mbox h2{color:var(--pri);margin-bottom:25px;font-size:1.5rem;text-align:center}
.mbox .mclose{position:absolute;top:15px;left:15px;background:var(--light);border:none;width:36px;height:36px;border-radius:50%;font-size:1.1rem;cursor:pointer;transition:var(--tr)}
.mbox .mclose:hover{background:#EF4444;color:#fff}
.mbox .fg{margin-bottom:18px}.mbox .fg label{display:block;font-weight:700;margin-bottom:6px;color:var(--pri);font-size:.88rem}
.mbox .fg input,.mbox .fg select,.mbox .fg textarea{width:100%;padding:13px 18px;border:2px solid var(--light);border-radius:12px;font-size:.95rem;transition:var(--tr)}
.mbox .fg input:focus,.mbox .fg select:focus,.mbox .fg textarea:focus{outline:none;border-color:var(--pri)}
.mbox .fg textarea{height:100px;resize:vertical}.mbox .submit{width:100%;padding:15px;background:var(--grad2);color:#fff;border-radius:12px;font-size:1.1rem;font-weight:700;transition:var(--tr)}
.mbox .submit:hover{transform:translateY(-2px);box-shadow:0 10px 30px rgba(255,107,53,.35)}

/* ===== ADMIN PANEL ===== */
.adm-btn{position:fixed;bottom:100px;left:30px;width:52px;height:52px;background:var(--grad2);color:#fff;border-radius:50%;font-size:1.3rem;cursor:pointer;box-shadow:0 8px 25px rgba(255,107,53,.35);z-index:998;transition:var(--tr);border:none;display:flex;align-items:center;justify-content:center}
[dir="ltr"] .adm-btn{left:auto;right:30px}
.adm-btn:hover{transform:scale(1.1)}
.ovbg{position:fixed;inset:0;background:rgba(0,0,0,.5);z-index:1999;opacity:0;visibility:hidden;transition:var(--tr);backdrop-filter:blur(3px)}
.ovbg.show{opacity:1;visibility:visible}
.adp{position:fixed;top:0;right:-520px;width:500px;height:100vh;background:#fff;z-index:2000;box-shadow:-8px 0 50px rgba(0,0,0,.15);transition:var(--tr);overflow-y:auto;padding:0}
[dir="ltr"] .adp{right:auto;left:-520px}
.adp.open{right:0}[dir="ltr"] .adp.open{right:auto;left:0}
.adp-hd{background:var(--grad1);color:#fff;padding:25px 30px;position:relative;flex-shrink:0}
.adp-hd h2{font-size:1.4rem}.adp-hd p{opacity:.8;font-size:.85rem;margin-top:4px}
.adp-hd .close-adm{position:absolute;top:15px;left:15px;background:rgba(255,255,255,.2);border:none;width:36px;height:36px;border-radius:50%;font-size:1.1rem;cursor:pointer;color:#fff;transition:var(--tr)}
[dir="ltr"] .adp-hd .close-adm{left:auto;right:15px}
.adp-hd .close-adm:hover{background:rgba(255,255,255,.3)}
.adp-body{padding:25px 30px}
.adm-tab{display:flex;gap:8px;margin-bottom:25px;flex-wrap:wrap}
.adm-tab button{padding:10px 18px;border-radius:10px;font-size:.85rem;font-weight:700;background:var(--light);color:var(--gray);transition:var(--tr);border:2px solid transparent}
.adm-tab button.on{background:var(--grad1);color:#fff;border-color:var(--pri)}
.adm-tab button:hover{border-color:var(--pri3)}
.adm-sec{display:none}.adm-sec.active{display:block}
.adm-sec h3{color:var(--pri);font-size:1.15rem;margin-bottom:20px;padding-bottom:10px;border-bottom:2px solid var(--light)}
.afg{margin-bottom:18px}.afg label{display:block;font-weight:700;margin-bottom:6px;color:var(--dark);font-size:.88rem}
.afg input,.afg select,.afg textarea{width:100%;padding:12px 16px;border:2px solid var(--light);border-radius:10px;font-size:.92rem;transition:var(--tr)}
.afg input:focus,.afg select:focus,.afg textarea:focus{outline:none;border-color:var(--pri);box-shadow:0 0 0 3px rgba(15,76,129,.08)}
.afg textarea{height:80px;resize:vertical}
.abtn{padding:12px 28px;border-radius:10px;font-weight:700;font-size:.95rem;transition:var(--tr);margin-right:8px;margin-bottom:10px;display:inline-flex;align-items:center;gap:8px}
.abtn-save{background:var(--grad1);color:#fff}.abtn-save:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(15,76,129,.3)}
.abtn-danger{background:#EF4444;color:#fff}.abtn-danger:hover{background:#DC2626}
.abtn-add{background:var(--grad2);color:#fff}.abtn-add:hover{transform:translateY(-2px);box-shadow:0 8px 25px rgba(255,107,53,.3)}
.asucc{display:none;text-align:center;color:#10B981;font-weight:700;padding:12px;background:#D1FAE5;border-radius:8px;margin-bottom:15px}

/* Admin cards for cars */
.adm-car-card{background:var(--light);border-radius:12px;padding:18px;margin-bottom:15px;display:flex;gap:15px;align-items:center;position:relative}
.adm-car-card img{width:80px;height:60px;object-fit:cover;border-radius:8px;flex-shrink:0}
.adm-car-card .info{flex:1}.adm-car-card .info h4{color:var(--pri);font-size:.95rem}.adm-car-card .info p{color:var(--gray);font-size:.82rem}
.adm-car-card .del{position:absolute;top:8px;left:8px;background:#EF4444;color:#fff;border:none;width:26px;height:26px;border-radius:50%;cursor:pointer;font-size:.75rem;display:flex;align-items:center;justify-content:center}
[dir="ltr"] .adm-car-card .del{left:auto;right:8px}

/* Admin clients */
.adm-client{background:var(--light);border-radius:12px;padding:18px;margin-bottom:12px;position:relative}
.adm-client h4{color:var(--pri);font-size:.95rem}.adm-client p{color:var(--gray);font-size:.85rem;margin-top:4px}
.adm-client .meta{font-size:.75rem;color:#9CA3AF;margin-top:6px}
.adm-client .del{position:absolute;top:8px;left:8px;background:#EF4444;color:#fff;border:none;width:26px;height:26px;border-radius:50%;cursor:pointer;font-size:.75rem;display:flex;align-items:center;justify-content:center}
[dir="ltr"] .adm-client .del{left:auto;right:8px}

.no-data{text-align:center;color:#9CA3AF;padding:30px;font-size:.95rem}

/* Admin login */
.adm-login{text-align:center;padding:20px 0}
.adm-login input{width:100%;padding:13px 18px;border:2px solid var(--light);border-radius:10px;font-size:1rem;margin-bottom:15px;text-align:center}
.adm-login .hint{font-size:.82rem;color:#9CA3AF;margin-top:15px}
.adm-login .hint strong{color:var(--acc)}

.rv{opacity:0;transform:translateY(45px);transition:all .8s ease}
.rv.vis{opacity:1;transform:translateY(0)}

@media(max-width:1100px){.ftg{grid-template-columns:1fr 1fr}}
