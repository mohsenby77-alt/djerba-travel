}

// ============ ADMIN PANEL ============
function openAdmin(){document.getElementById('adp').classList.add('open');document.getElementById('ovbg').classList.add('show');if(sessionStorage.getItem('tj_auth'))showAdminContent()}
function closeAdmin(){document.getElementById('adp').classList.remove('open');document.getElementById('ovbg').classList.remove('show')}

function doLogin(){
var pass=localStorage.getItem('tj_pass')||'admin123';
if(document.getElementById('admPass').value===pass){sessionStorage.setItem('tj_auth','1');showAdminContent()}
else alert('❌ كلمة المرور خاطئة!');
}

function showAdminContent(){
document.getElementById('admLogin').style.display='none';
document.getElementById('admContent').style.display='block';
